# Database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

EXPO_PUBLIC_SUPABASE_URL="www.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="1234"

# Paddle (web billing only – client-side token + price IDs from Dashboard)
# Get client token: Paddle Dashboard → Developer tools → Authentication → Client-side token
# Get price IDs: Paddle Dashboard → Products → your product → Prices (each price has id pri_xxx)
EXPO_PUBLIC_PADDLE_VENDOR_ID="11111"
EXPO_PUBLIC_PADDLE_CLIENT_TOKEN="test_xxxxxxxx"
EXPO_PUBLIC_PADDLE_PRICE_ID_MONTHLY="pri_xxxxxxxx"
EXPO_PUBLIC_PADDLE_PRICE_ID_ANNUAL="pri_xxxxxxxx"
EXPO_PUBLIC_PADDLE_ENVIRONMENT="sandbox"
# Optional: set to "sandbox" when testing (token test_xxx = sandbox, live_xxx = live)
# EXPO_PUBLIC_PADDLE_ENVIRONMENT="sandbox"